#ifndef MSL_UTILITY_
#define MSL_UTILITY_

/* Minimal stand-in for the MSL <utility>. */
namespace std {

#ifdef MSL_PAIR_COPY_CALL
inline void __pair_nothing() {}
#endif

template <class T1, class T2> struct pair {
    typedef T1 first_type;
    typedef T2 second_type;

    pair() : first(), second() {}
    pair(const T1 &a, const T2 &b) : first(a), second(b) {}
#ifdef MSL_PAIR_CONVERTING_CONSTRUCTOR
    /* Compiled only where MSL_PAIR_CONVERTING_CONSTRUCTOR is defined before this header
     * (Game/TrigerCounter.cpp): every template declaration advances CodeWarrior's @N counter. */
    template <class U1, class U2> pair(const pair<U1, U2> &p) : first(p.first), second(p.second) {}
#endif

#ifdef MSL_PAIR_COPY_CALL
    /* Where MSL_PAIR_COPY_CALL is defined before this header (Game/DeltaMorphAnimManagerTask.cpp),
     * the copy constructor calls an inline function, so that it stays out of line as the game has
     * it there. */
    pair(const pair &p) : first(p.first), second(p.second) {
        __pair_nothing();
    }
#endif

    T1 first;
    T2 second;
};

#ifdef MSL_MAKE_PAIR_BY_VALUE
/* Where MSL_MAKE_PAIR_BY_VALUE is defined before this header (Game/csdmProject.cpp), make_pair takes
 * its arguments by value, as the game's tree's equal_range calls it (each argument is copied first). */
template <class T1, class T2> inline pair<T1, T2> make_pair(T1 a, T2 b) {
    return pair<T1, T2>(a, b);
}
#else
template <class T1, class T2> inline pair<T1, T2> make_pair(const T1 &a, const T2 &b) {
    return pair<T1, T2>(a, b);
}
#endif

} // namespace std

#endif
