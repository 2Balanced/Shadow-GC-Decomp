#ifndef MSL_ALGORITHM_
#define MSL_ALGORITHM_

/* Minimal stand-in for the MSL <algorithm>: what boost's headers name, and the
 * algorithms <vector> uses. */
namespace std {

template <class T> inline void swap(T &a, T &b) {
    T tmp(a);
    a = b;
    b = tmp;
}

template <class T> inline const T &min(const T &a, const T &b) {
    return b < a ? b : a;
}

template <class T> inline const T &max(const T &a, const T &b) {
    return a < b ? b : a;
}

/* Assigns value to n elements from first. */
template <class OutputIterator, class Size, class T>
inline void fill_n(OutputIterator first, Size n, const T &value) {
    for (; n != 0; ++first, --n) {
        *first = value;
    }
}

template <class BidirectionalIterator1, class BidirectionalIterator2>
inline BidirectionalIterator2 __copy_backward(BidirectionalIterator1 first, BidirectionalIterator1 last,
                                       BidirectionalIterator2 result) {
    while (last > first) {
        *--result = *--last;
    }
    return result;
}

/* Copies [first, last) backwards so that it ends at result. */
template <class BidirectionalIterator1, class BidirectionalIterator2>
inline BidirectionalIterator2 copy_backward(BidirectionalIterator1 first, BidirectionalIterator1 last,
                                     BidirectionalIterator2 result) {
    return __copy_backward(first, last, result);
}

#ifdef MSL_ALGORITHM_COPY
/* Forward copy (only units that define MSL_ALGORITHM_COPY see it: another template here renumbers
 * the compiler's @N local symbols in every unit that includes this header). */
template <class InputIterator, class OutputIterator>
inline OutputIterator __copy(InputIterator first, InputIterator last, OutputIterator result) {
    for (; first < last; ++first, ++result) {
        *result = *first;
    }
    return result;
}

/* Copies [first, last) to result. */
template <class InputIterator, class OutputIterator>
inline OutputIterator copy(InputIterator first, InputIterator last, OutputIterator result) {
    return __copy(first, last, result);
}
#endif

#ifdef MSL_ALGORITHM_REMOVE_IF
/* find_if, remove_copy_if and remove_if (only units that define MSL_ALGORITHM_REMOVE_IF see them,
 * for the reason given at MSL_ALGORITHM_COPY; Game/BasicMessage.cpp). find_if is inline, so the game
 * emits it right after remove_if, which passes it the predicate by reference; remove_copy_if is
 * not, so it comes out at the end of the unit. */
template <class InputIterator, class Predicate>
inline InputIterator find_if(InputIterator first, InputIterator last, Predicate pred) {
    while (first != last && !pred(*first)) {
        ++first;
    }
    return first;
}

template <class InputIterator, class OutputIterator, class Predicate>
OutputIterator remove_copy_if(InputIterator first, InputIterator last, OutputIterator result, Predicate pred) {
    for (; first != last; ++first) {
        if (!pred(*first)) {
            *result = *first;
            ++result;
        }
    }
    return result;
}

template <class ForwardIterator, class Predicate>
ForwardIterator remove_if(ForwardIterator first, ForwardIterator last, Predicate pred) {
    first = find_if<ForwardIterator, Predicate &>(first, last, pred);
    return first == last ? first : remove_copy_if(first + 1, last, first, pred);
}
#endif

#ifdef MSL_ALGORITHM_UPPER_BOUND
/* upper_bound with operator< (only units that define MSL_ALGORITHM_UPPER_BOUND see it, for the
 * reason given at MSL_ALGORITHM_COPY; Game/VibrationManagerUnit.cpp keeps a sorted list). The
 * element is read through the iterator's operator->, which retail expands inline there. */
template <class ForwardIterator, class T>
ForwardIterator upper_bound(ForwardIterator first, ForwardIterator last, const T &value) {
    typedef typename iterator_traits<ForwardIterator>::difference_type difference_type;
    difference_type len = distance(first, last);
    while (len > 0) {
        ForwardIterator i = first;
        difference_type half = len / 2;
        advance(i, half);
        if (!(value < *i.operator->())) {
            first = ++i;
            len -= half + 1;
        } else {
            len = half;
        }
    }
    return first;
}
#endif

#ifdef MSL_ALGORITHM_SORT
/* sort and its helpers (only units that define MSL_ALGORITHM_SORT see them, for the reason given
 * at MSL_ALGORITHM_COPY; Game/CountMessage.cpp, Game/TimerMessage.cpp). The game's sort is a
 * quicksort on a median of three, picked a quarter and three quarters into the range with a
 * small offset that cycles from -4 to 4, and a selection sort below 21 elements. */
template <class ForwardIterator1, class ForwardIterator2>
inline void iter_swap(ForwardIterator1 a, ForwardIterator2 b) {
    swap(*a, *b);
}

template <class ForwardIterator, class Compare>
ForwardIterator min_element(ForwardIterator first, ForwardIterator last, Compare comp) {
    ForwardIterator result = first;
    if (first != last) {
        for (++first; first != last; ++first) {
            if (comp(*first, *result)) {
                result = first;
            }
        }
    }
    return result;
}

template <class BidirectionalIterator, class Compare>
void __selection_sort(BidirectionalIterator first, BidirectionalIterator last, Compare comp) {
    if (first != last) {
        BidirectionalIterator j = last;
        --j;
        for (; first < j; ++first) {
            BidirectionalIterator i = min_element(first, last, comp);
            if (i != first) {
                iter_swap(i, first);
            }
        }
    }
}

/* Orders *a, *b and *c so that the median ends up in *c. */
template <class RandomAccessIterator, class Compare>
void __median_of_3(RandomAccessIterator a, RandomAccessIterator b, RandomAccessIterator c, Compare comp) {
    bool x = !comp(*c, *a);
    bool y = !comp(*b, *c);
    if (x && y) {
        return;
    }
    if (!x && !y) {
        iter_swap(a, b);
        return;
    }
    if (comp(*b, *a)) {
        iter_swap(a, b);
    }
    if (x) {
        iter_swap(b, c);
    } else {
        iter_swap(a, c);
    }
}

template <class RandomAccessIterator, class Compare>
void sort(RandomAccessIterator first, RandomAccessIterator last, Compare comp) {
    for (;;) {
        int len = last - first;
        if (len <= 1) {
            return;
        }
        if (len <= 20) {
            __selection_sort(first, last, comp);
            return;
        }
        /* A static in a template: GC/2.7 guards its initialisation, as in the game. */
        static int jitter = -4;
        RandomAccessIterator m1 = first + (len / 4 + jitter % 5);
        if (++jitter >= 5) {
            jitter = -4;
        }
        len = len * 3 / 4; /* reusing len gives the game's register allocation */
        RandomAccessIterator m2 = first + (len + jitter % 5);
        if (++jitter >= 5) {
            jitter = -4;
        }
        RandomAccessIterator i; /* declared before pivot for the game's registers */
        RandomAccessIterator j;
        RandomAccessIterator pivot = last - 1;
        __median_of_3(m1, m2, pivot, comp);
        i = first;
        j = pivot;
        while (comp(*i, *pivot)) {
            ++i;
        }
        while (i != --j && !comp(*j, *pivot)) {
        }
        if (i < j) {
            iter_swap(i, j);
            ++i;
            for (;;) {
                while (comp(*i, *pivot)) {
                    ++i;
                }
                while (!comp(*--j, *pivot)) {
                }
                if (i >= j) {
                    break;
                }
                iter_swap(i, j);
                ++i;
            }
        }
        if (i == first) {
            /* Nothing below the pivot: put it first and split what is not above it. */
            iter_swap(i, pivot);
            ++i;
            j = last;
            if (!comp(*first, *--j)) {
                while (i != last && !comp(*first, *i)) {
                    ++i;
                }
                if (i < j) {
                    iter_swap(i, j);
                }
            }
            if (i < j) {
                for (;;) {
                    while (!comp(*first, *i)) {
                        ++i;
                    }
                    while (comp(*first, *--j)) {
                    }
                    if (i >= j) {
                        break;
                    }
                    iter_swap(i, j);
                    ++i;
                }
            }
            first = i;
        } else if (i - first < last - i) {
            sort(first, i, comp);
            first = i;
        } else {
            sort(i, last, comp);
            last = i;
        }
    }
}
#endif

} // namespace std

#endif
