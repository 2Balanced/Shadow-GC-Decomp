#ifndef MSL_SET_
#define MSL_SET_

#include <functional>
#include <map>
#include <memory>
#include <vector>

/* Stand-in for the MSL <set>, reconstructed from the set<boost::weak_ptr<CharInfo> > instances
 * Game/LightColli.cpp emits (0x801EDCE8..0x801F1904). It is built on the tree of <map>: the same
 * nodes, node allocator, end node and leftmost node, rebalancing and stepping. What differs from a
 * map's tree is the storage of the size, which is kept with a std::allocator of the values (the
 * vector's __vec_cap_pair, whose constructor the game calls by name), the ordering (the set's
 * comparison itself, which takes no room, so the leftmost node follows the end node directly), and
 * the values, constructed and destroyed through std::allocator. The set's iterator is a class of its
 * own whose members are all out of line in the game.
 *
 * As in <map>, which members are written inline and which call an inline helper so that they stay
 * out of line reproduces the game's call structure (deferred inlining one level deep), and the
 * tree's larger members are defined in <set_impl>, which a unit includes after its own code. The
 * electric panels' set<int> (Game/ElecPanel.h, Game/ElecPanelManagerTask.cpp) uses it too. Names are
 * invented; the original MSL source is not used. */

namespace std {

#ifdef MSL_SET_CONST_ITERATOR
/* Where MSL_SET_CONST_ITERATOR is defined before this header (Game/ElecPanelManagerTask.cpp), the
 * set's const_iterator is a class of its own, not a base of the iterator: it is made from an
 * iterator out of line (through the iterator's conversion to the tree's iterator), and its members
 * are all out of line too. */
template <class T> class __set_iterator;

template <class T> class __set_const_iterator {
  public:
    __set_const_iterator() {
        __tree_nothing();
    }
    __set_const_iterator(const __set_const_iterator &x) {
        node_ = x.node_;
        __tree_nothing();
    }
    __set_const_iterator(const __set_iterator<T> &x);
    __set_const_iterator &operator=(const __set_const_iterator &x) {
        assign(x);
        return *this;
    }

    /* The tree's iterator at the same node (the tree's erase takes one). */
    operator __tree_iterator<T>() const {
        __tree_nothing();
        return __tree_iterator<T>(node_);
    }
    const T &operator*() const {
        __tree_nothing();
        return static_cast<__tree_node<T> *>(node_)->value_;
    }
    __set_const_iterator &operator++() {
        fn_80012E90(&node_);
        return *this;
    }
    __set_const_iterator operator++(int) {
        __set_const_iterator tmp(*this);
        ++*this;
        return tmp;
    }
    bool operator!=(const __set_const_iterator &x) const {
        __tree_nothing();
        return node_ != x.node_;
    }
    bool operator!=(const __set_iterator<T> &x) const {
        return *this != __set_const_iterator(x);
    }

  private:
    void assign(const __set_const_iterator &x) {
        node_ = x.node_;
        __tree_nothing();
    }

  public:
    /* 0x0 */ __tree_node_base *node_;
};

