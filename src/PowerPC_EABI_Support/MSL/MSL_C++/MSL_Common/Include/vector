#ifndef MSL_VECTOR_
#define MSL_VECTOR_

#include <algorithm>
#include <cstddef>
#include <memory>

/* Stand-in for the MSL <vector>, reconstructed from the vector<boost::shared_ptr<Target>> code that
 * DEFENSE_SYSTEM's unit emits (0x80223FB8..0x80225284): only reserve, push_back (through the
 * fill-insert), begin, end and destruction. The layout is the capacity (stored with the allocator,
 * which takes no room), the size, then the data pointer. Which members are written inline is chosen
 * to reproduce the game's call structure (the original MSL source is not used here); the class
 * names below the vector are invented. */
namespace std {

/* Returns x. Accessors go through it, so that, inlining it, they are not inlined themselves
 * (deferred inlining is one level deep) and come out as the game's small out-of-line copies. */
template <class T> inline T &__vec_ref(T &x) {
    return x;
}

template <class T> inline const T &__vec_ref(const T &x) {
    return x;
}

/* Where MSL_VECTOR_DESTROY_ALL_LATE is defined before this header (Game/GadgetParticle.cpp),
 * destroy_all is only declared here and defined by <vector_impl>, which the unit includes after its
 * own code: the game then emits destroy_all with the vector's last members, not after clear. */
#ifdef MSL_VECTOR_DESTROY_ALL_LATE
inline void __vec_nothing() {}
#endif

/* The capacity stored with the (empty) allocator. */
template <class A, class S> struct __vec_cap_storage : public A {
    __vec_cap_storage(S n) : second_(n) {}
    __vec_cap_storage(const A &a, S n) : A(a), second_(n) {}
    void swap(__vec_cap_storage &x) {
        std::swap(second_, x.second_);
    }

    S second_;
};

template <class A, class S> struct __vec_cap_pair : public __vec_cap_storage<A, S> {
    __vec_cap_pair(S n) : __vec_cap_storage<A, S>(n) {}
    __vec_cap_pair(const A &a, S n) : __vec_cap_storage<A, S>(a, n) {}

    A &first() {
        return __vec_ref<A>(*this);
    }
    const A &first() const {
        return __vec_ref<A>(*this);
    }
    S &second() {
        return __vec_ref(this->second_);
    }
    const S &second() const {
        return __vec_ref(this->second_);
    }
    void swap(__vec_cap_pair &x) {
        __vec_cap_storage<A, S>::swap(x);
    }
};

template <class A, class S>
inline void __vec_swap(__vec_cap_pair<A, S> &a, __vec_cap_pair<A, S> &b) {
    a.swap(b);
}

/* The storage and the operations that do not depend on the vector's interface. */
template <class T, class A> class __vec_base {
  public:
    typedef T value_type;
    typedef T *pointer;
    typedef T *iterator;
    typedef const T &const_reference;
    typedef size_t size_type;
    typedef A allocator_type;

    __vec_base() : cap_(0), size_(0), data_(0) {}
    __vec_base(const A &a) : cap_(a, 0), size_(0), data_(0) {}
    ~__vec_base();
#ifdef MSL_VECTOR_DESTROY_ALL_FIRST
    /* Where MSL_VECTOR_DESTROY_ALL_FIRST is defined before this header (Game/BasicMessage.cpp),
     * destroy_all is declared before the other members, which puts it after reserve among the
     * late-defined members the game emits at the end of the unit. */
  protected:
    void destroy_all();

  public:
#endif

    iterator begin() {
        return __vec_ref(data_);
    }
    iterator end() {
        return __vec_ref(data_) + size_;
    }
    size_type size() const {
        return __vec_ref(size_);
    }
    size_type capacity() const {
        return cap_.second();
    }
    size_type max_size() const {
        return cap_.first().max_size();
    }
    void reserve(size_type n);
#ifdef MSL_VECTOR_AT
    /* Only where MSL_VECTOR_AT is defined before this header (Game/CameraScreenSet.cpp); defined
     * after the class, so the game emits it at the end of the unit with insert_n. */
    T &at(size_type n);
#endif
    void push_back(const T &x) {
        insert_n(end(), 1, x);
    }
#ifdef MSL_VECTOR_BACK
    /* Only where MSL_VECTOR_BACK is defined before this header (Game/CountMessage.cpp,
     * Game/TimerMessage.cpp). */
    bool empty() const {
        return __vec_ref(size_) == 0;
    }
    T &back() {
        return *(__vec_ref(data_) + size_ - 1);
    }
    void pop_back() {
        A &a = cap_.first();
        a.destroy(data_ + --size_);
    }
#endif
    void swap(__vec_base &x) {
        if (this != &x) {
            __vec_swap(cap_, x.cap_);
            std::swap(data_, x.data_);
            std::swap(size_, x.size_);
        }
    }

  protected:
    pointer &data() {
        return __vec_ref(data_);
    }
#if defined(MSL_VECTOR_DESTROY_ALL_FIRST)
#elif defined(MSL_VECTOR_DESTROY_ALL_LATE)
    void destroy_all();
#else
    void destroy_all() {
        pointer first = data_;
        pointer last = first + size_;
        while (last > first) {
            cap_.first().destroy(--last);
        }
        size_ = 0;
    }
#endif
    void insert_n(iterator position, size_type n, const T &x);
#ifdef MSL_VECTOR_ERASE
    /* Only where MSL_VECTOR_ERASE is defined before this header (Game/BasicMessage.cpp). The
     * members defined out of line come out at the end of the unit in reverse declaration order;
     * declared last, erase comes first, as in the game. */
  public:
    iterator erase(iterator first, iterator last);
#endif
#ifdef MSL_VECTOR_ERASE_ONE
    /* Only where MSL_VECTOR_ERASE_ONE is defined before this header (Game/AdvCsdCache.cpp, which
     * also defines MSL_ALGORITHM_COPY). Declared last, it comes out first of the members defined
     * out of line, as in the game. */
  public:
    iterator erase(iterator position);
#endif

    __vec_cap_pair<A, size_type> cap_;
    size_type size_;
    pointer data_;
};

template <class T, class A> inline void __vec_swap(__vec_base<T, A> &a, __vec_base<T, A> &b) {
    a.swap(b);
}

template <class T, class A> __vec_base<T, A>::~__vec_base() {
    destroy_all();
    if (data_ != 0) {
        cap_.first().deallocate(data(), cap_.second());
    }
}

template <class T, class A> void __vec_base<T, A>::reserve(size_type n) {
    if (n > capacity()) {
        if (n > max_size()) {
            __msl_error("vector::reserve length error\n");
        }
        __vec_base tmp(cap_.first());
        tmp.data_ = tmp.cap_.first().allocate(n, 0);
        tmp.cap_.second() = n;
        pointer dest = tmp.data_;
        pointer src = begin();
        pointer last = end();
        for (; src < last; ++src, ++dest) {
            tmp.cap_.first().construct(dest, *src);
            ++tmp.size_;
        }
        __vec_swap(tmp, *this);
    }
}

#ifdef MSL_VECTOR_AT
template <class T, class A> T &__vec_base<T, A>::at(size_type n) {
    if (n >= size_) {
        __msl_error("vector::at index out of range");
    }
    return data_[n];
}
#endif

/* Inserts n copies of x before position. */
template <class T, class A>
void __vec_base<T, A>::insert_n(iterator position, size_type n, const T &x) {
    if (n != 0) {
        size_type ms = max_size();
        if (n > ms || size_ > ms - n) {
            __msl_error("vector::insert length error\n");
        }
        if (size_ + n <= capacity()) {
            const T *xp = &x;
            pointer old_end = end();
            size_type after = old_end - position;
            if (n > after) {
                pointer dest = old_end;
                for (; n > after; ++dest, --n) {
                    cap_.first().construct(dest, *xp);
                    ++size_;
                }
                for (pointer src = position; src < old_end; ++src, ++dest) {
                    cap_.first().construct(dest, *src);
                    ++size_;
                }
            } else {
                pointer src = old_end - n;
                for (pointer dest = old_end; src < old_end; ++src, ++dest) {
                    cap_.first().construct(dest, *src);
                    ++size_;
                }
                size_type moved = after - n;
                if (old_end - moved <= xp && xp < old_end) {
                    xp += n;
                }
                copy_backward(position, position + moved, old_end);
            }
            fill_n(position, n, *xp);
        } else {
            __vec_base tmp(cap_.first());
            size_type new_size = size_ + n;
            size_type cap = cap_.second() != 0 ? cap_.second() : 1;
            const size_type limit = ms;
            while (new_size > cap) {
                if (cap < limit / 2) {
                    cap *= 2;
                } else {
                    cap = limit;
                }
            }
            tmp.data_ = tmp.cap_.first().allocate(cap, 0);
            tmp.cap_.second() = cap;
            pointer dest = tmp.data_;
            pointer src = begin();
            pointer last = end();
            for (; src < position; ++src, ++dest) {
                tmp.cap_.first().construct(dest, *src);
                ++tmp.size_;
            }
            for (; n != 0; ++dest, --n) {
                tmp.cap_.first().construct(dest, x);
                ++tmp.size_;
            }
            for (; src < last; ++src, ++dest) {
                tmp.cap_.first().construct(dest, *src);
                ++tmp.size_;
            }
            __vec_swap(tmp, *this);
        }
    }
}

#ifdef MSL_VECTOR_MIDDLE
/* Where MSL_VECTOR_MIDDLE is defined before this header (Game/Mission.cpp), a class sits between
 * the vector and its storage: the game emits its constructor out of line there and inlines its
 * destructor's null check into the vector's. */
template <class T, class A> class __vec_middle : public __vec_base<T, A> {
  public:
    __vec_middle() {}
};
#define __MSL_VECTOR_PARENT __vec_middle<T, A>
#else
#define __MSL_VECTOR_PARENT __vec_base<T, A>
#endif

template <class T, class A = allocator<T> > class vector : public __MSL_VECTOR_PARENT {
  public:
    typedef __vec_base<T, A> base;
    typedef typename base::iterator iterator;
    typedef typename base::size_type size_type;

    vector() {}

    iterator begin() {
        return base::begin();
    }
    iterator end() {
        return base::end();
    }
    void push_back(const T &x) {
        base::push_back(x);
    }
    void reserve(size_type n) {
        base::reserve(n);
    }
#ifdef MSL_VECTOR_BACK
    T &back() {
        return base::back();
    }
    void pop_back() {
        base::pop_back();
    }
#endif
    void clear() {
#ifdef MSL_VECTOR_DESTROY_ALL_LATE
        /* destroy_all is defined after the unit's code (<vector_impl>), so it does not keep clear
         * out of line; the inline call does. */
        base::destroy_all();
        __vec_nothing();
#else
        base::destroy_all();
#endif
    }
};

#ifdef MSL_VECTOR_ERASE
template <class T, class A> typename __vec_base<T, A>::iterator __vec_base<T, A>::erase(iterator first, iterator last) {
    if (first == last) {
        return first;
    }
    iterator e = end();
    size_type n = e - last;
    if (n != 0) {
        copy(last, e, first);
    }
    for (iterator p = first + n; p < e; ++p) {
        this->cap_.first().destroy(p);
    }
    this->size_ -= last - first;
    return first;
}
#endif

#ifdef MSL_VECTOR_ERASE_ONE
template <class T, class A> typename __vec_base<T, A>::iterator __vec_base<T, A>::erase(iterator position) {
    iterator e = end();
    if (e - position - 1 != 0) {
        copy(position + 1, e, position);
    }
    A &a = cap_.first();
    a.destroy(data_ + --size_);
    return position;
}
#endif

} // namespace std

#endif
