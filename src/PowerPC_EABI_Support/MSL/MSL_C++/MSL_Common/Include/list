#ifndef MSL_LIST_
#define MSL_LIST_

#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <memory>

/* Stand-in for the MSL <list>, reconstructed from the instances the game's code emits (first
 * Game/GadgetModelInfo.cpp, 0x8015FB10..0x801656F0): a doubly linked list whose nodes hold their
 * links first (previous, then next) and the value at 0x8, and whose object is {size, end node}.
 * The end node links the first and the last node.
 *
 * Which members are written inline and which call an inline helper so that they stay out of line
 * reproduces the game's call structure: with deferred inlining one level deep, only an inline
 * function that calls no other inline function is expanded. insert, erase and the constructor of
 * the list's storage are defined after the class: the game emits them at the end of a unit, after
 * the code that uses them. A new node is held by __list_holder until it is linked in, so an
 * exception thrown by the value's copy constructor would free it. The iterator keeps a pointer to
 * the node type itself (the end node is cast to it): reaching the value through a cast from the
 * link type would let the compiler share the value's address between a member read and a call,
 * which retail does not. operator* goes through operator-> and so is called out of line. Units
 * that use the list include <list> before <boost/function.hpp>: the game emits the list's
 * instances before boost::function's. Names are invented; the original MSL source is not used. */

namespace std {

/* Returns x, and does nothing (inline calls that keep their callers out of line). */
template <class T> inline T __list_id(T x) {
    return x;
}

inline void __list_nothing() {}

struct __list_node_base {
    /* 0x0 */ __list_node_base *prev_;
    /* 0x4 */ __list_node_base *next_;
};

template <class T> struct __list_node : public __list_node_base {
    /* 0x8 */ T data_;
};

template <class T> class __list_iterator {
  public:
#ifdef MSL_LIST_VIBRATION
    /* Only where MSL_LIST_VIBRATION is defined before this header (Game/VibrationManagerUnit.cpp,
     * which includes <iterator> first): the traits upper_bound needs, and operator--. */
    typedef bidirectional_iterator_tag iterator_category;
    typedef T value_type;
    typedef ptrdiff_t difference_type;
    typedef T *pointer;
    typedef T &reference;

    __list_iterator &operator--() {
        node_ = static_cast<__list_node<T> *>(node_->prev_);
        return *this;
    }
#endif
    __list_iterator() {}
    explicit __list_iterator(__list_node_base *n) : node_(static_cast<__list_node<T> *>(n)) {}
    __list_iterator(const __list_iterator &x) : node_(x.node_) {}

    T *operator->() const {
        return &node_->data_;
    }
#ifdef MSL_LIST_DEREF_DIRECT
    /* Only where MSL_LIST_DEREF_DIRECT is defined before this header (Game/TargetManageTask.cpp,
     * whose for_each reads the value directly). */
    T &operator*() const {
        return node_->data_;
    }
#else
    T &operator*() const {
        return *operator->();
    }
#endif
    __list_iterator &operator++() {
        node_ = static_cast<__list_node<T> *>(node_->next_);
        return *this;
    }
    __list_iterator operator++(int) {
        __list_iterator tmp(*this);
        ++*this;
        return tmp;
    }
    bool operator==(const __list_iterator &x) const {
        return node_ == x.node_;
    }
    bool operator!=(const __list_iterator &x) const {
        return node_ != x.node_;
    }

    /* 0x0 */ __list_node<T> *node_;
};

#ifdef MSL_LIST_RANGE_INSERT
/* Only where MSL_LIST_RANGE_INSERT is defined before this header (Game/PlayerCharaColliImpl.cpp):
 * the const iterator, and the range insertion below. Its operator* reads the value directly. */
template <class T> class __list_const_iterator {
  public:
    explicit __list_const_iterator(const __list_node_base *n)
        : node_(static_cast<const __list_node<T> *>(n)) {}

    const T &operator*() const {
        return node_->data_;
    }
    __list_const_iterator &operator++() {
        node_ = static_cast<const __list_node<T> *>(node_->next_);
        return *this;
    }
    __list_const_iterator operator++(int) {
        __list_const_iterator tmp(*this);
        ++*this;
        return tmp;
    }
    bool operator==(const __list_const_iterator &x) const {
        return node_ == x.node_;
    }
    bool operator!=(const __list_const_iterator &x) const {
        return node_ != x.node_;
    }

    /* 0x0 */ const __list_node<T> *node_;
};

/* The category tag the range insertion dispatches on. */
struct __list_input_tag {};
#endif

/* The allocators of the values and of the nodes (an allocation failure aborts). */
template <class T> class __list_value_allocator {
  public:
    __list_value_allocator() {}
#if defined(MSL_LIST_RANGE_INSERT) || defined(MSL_LIST_MERGE)
    bool operator==(const __list_value_allocator &) const {
        return true;
    }
#endif

    void construct(T *p, const T &value) {
        new ((void *)p) T(value);
    }
#ifdef MSL_LIST_TRIVIAL_VALUES
    /* Only where MSL_LIST_TRIVIAL_VALUES is defined before this header (Game/EffectKage.cpp): the
     * values have no destructor, and retail expands destroy where it is called. */
    void destroy(T *p) {}
#else
    void destroy(T *p) {
        p->~T();
        __list_nothing();
    }
#endif
};

template <class N> class __list_node_allocator {
  public:
    __list_node_allocator() {}
    __list_node_allocator(const __list_node_allocator &) {
        __list_nothing();
    }
    template <class U> __list_node_allocator(const __list_value_allocator<U> &) {}

    N *allocate(size_t n, const void *hint = 0) {
        N *p = static_cast<N *>(::operator new(n * sizeof(N)));
        if (p == 0) {
            __msl_error("Memory allocation failure");
        }
        return p;
    }
    void deallocate(N *p, size_t) {
        ::operator delete(p);
    }
};

/* What frees a node that was never linked in (it holds nothing). */
template <class N> struct __list_node_deleter {
    void reset() {
        __list_nothing();
    }
};

/* The deleter and the node (the deleter is empty and takes no room). */
template <class D, class P> struct __list_ptr_pair : public D {
    __list_ptr_pair(const D &d, P p) : D(d), second_(__list_id(p)) {}
    __list_ptr_pair(const __list_ptr_pair &x) : second_(__list_id(x.second_)) {}

    D &first() {
        return *this;
    }
    P &second() {
        return second_;
    }

    /* 0x0 */ P second_;
};

/* Owns a new node until it is linked in. */
template <class N, class A, class D> class __list_holder_imp {
  public:
    __list_holder_imp(A &a, const __list_ptr_pair<D, N *> &p) : alloc_(a), ptr_(p) {}

    /* 0x0 */ A &alloc_;
    /* 0x4 */ __list_ptr_pair<D, N *> ptr_;
};

template <class N, class A, class D> class __list_holder_base : public __list_holder_imp<N, A, D> {
  public:
    __list_holder_base(A &a, const __list_ptr_pair<D, N *> &p) : __list_holder_imp<N, A, D>(a, p) {}
};

template <class N, class A, class D> class __list_holder : public __list_holder_base<N, A, D> {
  public:
    __list_holder(N *p, A &a, D d)
        : __list_holder_base<N, A, D>(a, __list_ptr_pair<D, N *>(d, p)) {}
    ~__list_holder() {
        if (get() != 0) {
            reset_deleter();
            alloc().deallocate(get(), 1);
        }
    }

    N *get() {
        return this->ptr_.second();
    }
    N *operator->() {
        return get();
    }
    N *release() {
        N *p = get();
        this->ptr_.second() = 0;
        return p;
    }
    A &alloc() {
        return this->alloc_;
    }
    D &deleter() {
        return this->ptr_.first();
    }
    bool reset_deleter() {
        deleter().reset();
        return true;
    }
};

/* The value allocator and the size (the allocator is empty and takes no room). */
template <class A, class S> struct __list_size_base : public A {
    __list_size_base(S n) : second_(__list_id(n)) {}
#ifdef MSL_LIST_RANGE_INSERT
    __list_size_base(const A &a, S n) : A(a), second_(__list_id(n)) {}
#endif

    /* 0x0 */ S second_;
};

template <class A, class S> struct __list_size_pair : public __list_size_base<A, S> {
    __list_size_pair(S n) : __list_size_base<A, S>(n) {}
#ifdef MSL_LIST_RANGE_INSERT
    __list_size_pair(const A &a, S n) : __list_size_base<A, S>(a, n) {}
#endif

    A &first() {
        return *this;
    }
    S &second() {
        return this->second_;
    }
#ifdef MSL_LIST_ACCESSORS
    const S &second() const {
        return this->second_;
    }
#endif
};

/* The node allocator and the end node. */
template <class A> struct __list_end_pair : public A {
    __list_end_pair(const A &a) : A(a) {}

    A &first() {
        return *this;
    }
    __list_node_base &second() {
        return second_;
    }
#ifdef MSL_LIST_RANGE_INSERT
    const __list_node_base &second() const {
        return second_;
    }
#endif

    /* 0x0 */ __list_node_base second_;
};

#ifdef MSL_LIST_RANGE_INSERT
template <class T> class list;
#endif

template <class T> class __list_imp {
  public:
    typedef size_t size_type;
    typedef __list_node<T> node;
    typedef __list_iterator<T> iterator;
    typedef __list_value_allocator<T> value_allocator;
    typedef __list_node_allocator<node> node_allocator;

#ifdef MSL_LIST_MERGE
    /* Only where MSL_LIST_MERGE is defined before this header (Game/PathData.cpp, whose list merge
     * moves what is left of the other list with it): defined after the class (the unit writes its
     * copy as an explicit specialization, which places it). */
    void do_splice(iterator position, __list_imp &x);
#endif
    __list_imp();
    ~__list_imp() {
        erase(begin(), end());
    }

    iterator begin() {
        return iterator(tail()->next_);
    }
    iterator end() {
        return iterator(tail());
    }
    iterator insert(iterator position, const T &x);
    iterator erase(iterator position);
    iterator erase(iterator first, iterator last);
#ifdef MSL_LIST_RANGE_INSERT
    typedef __list_const_iterator<T> const_iterator;

    __list_imp(const value_allocator &a) : size_(a, 0), tail_(node_allocator(alloc())) {
        __list_node_base *t = tail();
        t->prev_ = t->next_ = t;
    }

    const_iterator begin() const {
        return const_iterator(tail()->next_);
    }
    const_iterator end() const {
        return const_iterator(tail());
    }
    const __list_node_base *tail() const {
        return &tail_.second();
    }
    /* Inserts [first, last) before position: the new nodes are built in a list of their own, which
     * is then spliced in. */
    template <class InputIterator> void insert(iterator position, InputIterator first, InputIterator last) {
        insert(position, first, last, __list_input_tag());
    }
    template <class InputIterator>
    void insert(iterator position, InputIterator first, InputIterator last, __list_input_tag);
    void splice(iterator position, __list_imp &x) {
        do_splice(position, x);
    }
    void do_splice(iterator position, __list_imp &x) {
        if (x.sz() != 0) {
            if (alloc() == x.alloc()) {
            }
            __list_node_base *p;
            __list_node_base *t = x.tail();
            __list_node_base *f = t->next_;
            __list_node_base *l = t->prev_;
            t->prev_ = t->next_ = t;
            p = position.node_;
            p->prev_->next_ = f;
            f->prev_ = p->prev_;
            p->prev_ = l;
            l->next_ = p;
            sz() += x.sz();
            x.sz() = 0;
        }
    }
#endif
#ifdef MSL_LIST_ACCESSORS
    /* Only where MSL_LIST_ACCESSORS is defined before this header (Game/CameraManagerUnit.cpp), so
     * that the other units' instances and local symbols stay as they are. */
    const size_type &sz() const {
        return size_.second();
    }
    size_type size() const {
        return sz();
    }
    bool empty() const {
        return sz() == 0;
    }
    T &front() {
        return static_cast<node *>(tail()->next_)->data_;
    }
#endif

    size_type &sz() {
        return size_.second();
    }
    value_allocator &alloc() {
        return size_.first();
    }
    node_allocator &node_alloc() {
        return tail_.first();
    }
    __list_node_base *tail() {
        return &tail_.second();
    }

    /* 0x0 */ __list_size_pair<value_allocator, size_type> size_;
    /* 0x4 */ __list_end_pair<node_allocator> tail_;
};

#ifdef MSL_LIST_RANGE_INSERT
template <class T> class __list_base : public __list_imp<T> {
  public:
    __list_base() {}
    template <class InputIterator>
    __list_base(InputIterator first, InputIterator last, const typename __list_imp<T>::value_allocator &a)
        : __list_imp<T>(a) {
        InputIterator i = first;
        init(i, last);
    }

    template <class InputIterator> void init(InputIterator first, InputIterator last) {
        for (; first != last; ++first) {
            static_cast<list<T> *>(this)->push_back(*first);
        }
    }
};
#else
template <class T> class __list_base : public __list_imp<T> {};
#endif

template <class T> class list : public __list_base<T> {
  public:
    typedef typename __list_imp<T>::iterator iterator;

    list() {}
    ~list() {}

    void push_back(const T &x) {
        this->insert(this->end(), x);
    }
#ifdef MSL_LIST_PUSH_FRONT
    /* Only where MSL_LIST_PUSH_FRONT is defined before this header (Game/StageCameraManager.cpp). */
    void push_front(const T &x) {
        this->insert(this->begin(), x);
    }
#endif
    void clear() {
        this->erase(this->begin(), this->end());
    }
#ifdef MSL_LIST_VIBRATION
    /* Only where MSL_LIST_VIBRATION is defined before this header (Game/VibrationManagerUnit.cpp,
     * which also defines MSL_FUNCTIONAL_BINDERS). */
    void remove(const T &value) {
        remove_if(bind2nd(equal_to<T>(), value));
    }
    template <class Predicate> void remove_if(Predicate pred);
#endif
};

#ifdef MSL_LIST_VIBRATION
template <class T> template <class Predicate> void list<T>::remove_if(Predicate pred) {
    iterator e = this->end();
    for (iterator i = this->begin(); i != e; ++i) {
        if (pred(i.node_->data_)) {
            iterator j = i;
            for (++j; j != e; ++j) {
                if (!pred(j.node_->data_)) {
                    break;
                }
            }
            i = this->erase(i, j);
            if (i == e) {
                break;
            }
        }
    }
}
#endif

#ifdef MSL_LIST_RANGE_INSERT
template <class T>
template <class InputIterator>
inline void __list_imp<T>::insert(iterator position, InputIterator first, InputIterator last, __list_input_tag) {
    __list_base<T> tmp(first, last, alloc());
    splice(position, tmp);
}
#endif

template <class T> __list_imp<T>::__list_imp() : size_(0), tail_(node_allocator(alloc())) {
    __list_node_base *t = tail();
    t->prev_ = t->next_ = t;
}

template <class T>
typename __list_imp<T>::iterator __list_imp<T>::insert(iterator position, const T &x) {
    __list_holder<node, node_allocator, __list_node_deleter<node> > h(
        node_alloc().allocate(1), node_alloc(), __list_node_deleter<node>());
    alloc().construct(&h->data_, x);
    node *p = h.release();
    __list_node_base *n = position.node_;
    n->prev_->next_ = p;
    p->prev_ = n->prev_;
    n->prev_ = p;
    p->next_ = n;
    ++sz();
    return iterator(p);
}

template <class T> typename __list_imp<T>::iterator __list_imp<T>::erase(iterator position) {
    __list_node_base *p = position.node_;
    ++position;
    p->prev_->next_ = p->next_;
    p->next_->prev_ = p->prev_;
    alloc().destroy(&static_cast<node *>(p)->data_);
    node_alloc().deallocate(static_cast<node *>(p), 1);
    --sz();
    return position;
}

template <class T>
typename __list_imp<T>::iterator __list_imp<T>::erase(iterator first, iterator last) {
    if (first == last) {
        return last;
    }
    __list_node_base *lp = last.node_->prev_;
    __list_node_base *fp = first.node_;
    fp->prev_->next_ = lp->next_;
    lp->next_->prev_ = fp->prev_;
    while (first != last) {
#ifdef MSL_LIST_TRIVIAL_VALUES
        /* operator-> feeds the expanded destroy, so retail calls it out of line. */
        alloc().destroy(first.operator->());
#else
        alloc().destroy(&static_cast<node *>(first.node_)->data_);
#endif
        __list_node_base *p = first.node_;
        ++first;
        node_alloc().deallocate(static_cast<node *>(p), 1);
        --sz();
    }
    return last;
}

} // namespace std

#endif
